# ---------- REQUIRED ----------
API_ID=12345678
API_HASH=your_api_hash_from_my.telegram.org
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
DATABASE_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=AutoFilterBot
COLLECTION_NAME=Telegram_files

# Your Telegram numeric id(s), space separated
ADMINS=123456789

# ---------- CHANNELS ----------
# Database channels (bot must be admin). Space separated, with -100 prefix
CHANNELS=-1001234567890 -1009876543210
# Log channel id (bot must be admin) - optional but recommended
LOG_CHANNEL=-1001112223334
# Force subscribe channel id (0 = off)
AUTH_CHANNEL=0

SUPPORT_CHAT=@YourSupportGroup
SUPPORT_LINK=https://t.me/YourSupportGroup
OWNER_USERNAME=YourUsername

# ---------- SHORTENER ----------
SHORTENER_SITE=shrinkme.io
SHORTENER_API=your_shortener_api_key
VERIFY_TUTORIAL=https://t.me/yourchannel/5
IS_SHORTENER=True
VERIFY_HOURS=24

# ---------- PREMIUM / TRIAL ----------
FREE_TRIAL_CLICKS=2
PREMIUM_PRICE=₹50 / month
PREMIUM_UPI=yourupi@okaxis

# ---------- BEHAVIOUR ----------
MAX_BTN=10
USE_CAPTION_FILTER=True
AUTO_DELETE=True
DELETE_TIME=600
PROTECT_CONTENT=False
PICS=https://telegra.ph/file/6f0b4d8f0dfe1a2d3b9d7.jpg
WORKERS=50
PORT=8080
